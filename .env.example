# Supabase configuration for TripDee
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
# Server-side service role key (Strictly secret - allows admin operations and passes RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-strictly-secret

# Admin Security & API Gate
# Server-only. Never expose the admin secret as a NEXT_PUBLIC_* variable — those
# are bundled into client JS and would make the admin console public.
ADMIN_SECRET_KEY=your-strong-admin-secret
# Signing key for the httpOnly session cookies (drivers + admin).
SESSION_SECRET=your-random-session-signing-secret

# LINE Login (OAuth 2.1)
LINE_CLIENT_ID=2011750506
LINE_CLIENT_SECRET=your-line-client-secret
NEXT_PUBLIC_LINE_CLIENT_ID=2011750506

# Google OAuth 2.0 (Direct OAuth)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Web Push Notifications (VAPID Keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@tripdee.com

# Mock Data Control (Demo Showcase vs Pure Production)
# - Set to "false" on Production (loads only real data from Supabase)
# - Set to "true" on Staging / Demo domains (loads 22 sample vehicles and sample trip board)
# - Can also override via URL query parameter: ?demo=1 or ?demo=0
NEXT_PUBLIC_ENABLE_MOCK_DATA=false

# Canonical Site URL
NEXT_PUBLIC_SITE_URL=https://www.tripdeeth.com

# LINE Messaging API Driver Dispatch (Push to LINE Group = 500 pushes/month free tier)
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_DRIVER_GROUP_ID=your-line-driver-group-id

# Telegram Bot Driver Dispatch (Optional backup channel)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_DRIVER_CHAT_ID=your-telegram-driver-chat-id

# Discord Webhook Driver Dispatch (Optional backup channel)
DISCORD_DRIVER_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ChillPay Payment Gateway
CHILLPAY_MERCHANT_CODE=your-merchant-code
CHILLPAY_API_KEY=your-api-key
CHILLPAY_MD5_KEY=your-md5-key
CHILLPAY_MD5_SECRET=your-md5-secret
CHILLPAY_ENVIRONMENT=sandbox

